# Unified diffs use one space for an empty context line; preserve valid patches.
experiments/phase3/patches/*.patch whitespace=-blank-at-eol
experiments/phase4/patches/*.patch whitespace=-blank-at-eol

data/lexicon/** text eol=lf
# Preserve upstream license bytes, including its final blank line.
data/lexicon/licenses/*.txt -text whitespace=-blank-at-eof
tools/lexicon/** text eol=lf
tools/dictionary/** text eol=lf
data/chinese/** text eol=lf
tools/lexicon_expand/** text eol=lf
data/lexicon-expansion/** text eol=lf
# These snapshots and notices retain the exact upstream bytes in sources.lock.json.
data/lexicon-expansion/sources/*.csv -text whitespace=-blank-at-eol,cr-at-eol
data/lexicon-expansion/notices/** -text whitespace=-blank-at-eof,-blank-at-eol,cr-at-eol

tools/packaging/** text eol=lf
packaging/** text eol=lf
packaging/patches/*.patch whitespace=-blank-at-eol
licensing/** text eol=lf
licensing/third-party/** -text whitespace=-blank-at-eof,-blank-at-eol
LICENSE -text whitespace=-blank-at-eof,cr-at-eol
src/study/windows/Product* text eol=lf
src/study/windows/UiPreferences.cpp text eol=lf
experiments/phase4/build-service.py text eol=lf
experiments/phase4/prepare-weasel.py text eol=lf

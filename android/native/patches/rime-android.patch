 void Memory::OnCommit(Context* ctx) {
+  // StudyIME: pause new learning without dropping existing scores.
+  if (ctx->get_property("study_user_learning") == "0")
+    return;
   if (!user_dict_ || user_dict_->readonly())
     return;
   StartSession();
   CommitEntry commit_entry(this);
+  vector<an<Phrase>> selected_phrases;
   for (auto& seg : ctx->composition()) {
     auto phrase =
         As<Phrase>(Candidate::GetGenuineCandidate(seg.GetSelectedCandidate()));
     bool recognized = Language::intelligible(phrase, this);
     if (recognized) {
       commit_entry.AppendPhrase(phrase);
+      if (seg.status >= Segment::kSelected && phrase->code().size() > 1)
+        selected_phrases.push_back(phrase);
     }
     if (!recognized || seg.status >= Segment::kConfirmed) {
       commit_entry.Save();
+      // A selected sentence can be flattened into individual words by
+      // AppendPhrase. Learn the selected span as a phrase as well.
+      for (const auto& selected : selected_phrases) {
+        if (selected->code().size() == commit_entry.code.size())
+          continue;
+        CommitEntry selection(this);
+        selection.AppendPhrase(selected);
+        selection.Save();
+      }
+      selected_phrases.clear();
       commit_entry.Clear();
     }
   }
